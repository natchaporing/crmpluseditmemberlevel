# Copy to .env.local and fill in. Never commit .env.local.

# --- App login -------------------------------------------------------------

# Signs the session cookie. Use a random string of at least 32 characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Operators allowed to sign in.
# Entries are separated by ";" (or newlines), fields by "|":
#   <username>|<display name>|<password hash>
# Generate a hash with:
#   npm run auth:hash -- somchai "Somchai J."
AUTH_USERS=

# --- Buzzebees API ---------------------------------------------------------

BUZZEBEES_APP_ID=
BUZZEBEES_USERNAME=
BUZZEBEES_PASSWORD=
BUZZEBEES_TERMINAL_ID=
BUZZEBEES_BRANCH_ID=
BUZZEBEES_BRAND_ID=

# Optional — override to point at a non-production environment.
# BUZZEBEES_MERCHANT_BASE_URL=https://api1servicewallet.buzzebees.com
# BUZZEBEES_STAMP_WALLET_BASE_URL=https://stampwalletmodule.buzzebees.com
