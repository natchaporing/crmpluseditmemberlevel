# Copy to .env.local and fill in. Never commit .env.local.

# --- App login -------------------------------------------------------------

# Signs the session cookie. Use a random string of at least 32 characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Operators sign in with their own Buzzebees credentials and type their
# Terminal ID, Branch ID and Brand ID on the login form. No credentials are
# configured here: the token an operator receives when they sign in is what
# their lookups and updates travel with.

# --- Buzzebees API ---------------------------------------------------------

BUZZEBEES_APP_ID=

# The agency (tenant) whose members and levels this deployment manages.
BUZZEBEES_AGENCY_ID=

# Optional — the endpoint that authenticates operators. Buzzebees exposes
# several login endpoints. A path is joined onto the merchant base URL; a whole
# URL is used as given.
# BUZZEBEES_LOGIN_PATH=/merchant/login

# Single sign-on, which issues the token the CRM Plus endpoints accept.
# Signing in hits this alongside the wallet login, so it carries an operator's
# real credentials — required, never defaulted.
BUZZEBEES_SSO_BASE_URL=

# Optional — the single sign-on endpoint, defaults to /auth/bzbs_login.
# BUZZEBEES_SSO_LOGIN_PATH=/auth/bzbs_login

# Optional — override to point at a non-production environment.
# BUZZEBEES_MERCHANT_BASE_URL=https://api1servicewallet.buzzebees.com
# BUZZEBEES_STAMP_WALLET_BASE_URL=https://stampwalletmodule.buzzebees.com
# BUZZEBEES_CRMPLUS_BASE_URL=https://buzzcrmplusssomodule.buzzebees.com
# BUZZEBEES_CRMPLUS_MODULE_BASE_URL=https://buzzcrmplusmodule.buzzebees.com
