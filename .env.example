# Copy to .env.local and fill in. Never commit .env.local.

# --- App login -------------------------------------------------------------

# Signs the session cookie. Use a random string of at least 32 characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Operators sign in with their own Buzzebees credentials and type their
# Terminal ID, Branch ID and Brand ID on the login form. There is no local
# user list, and none of those three are configured here.

# --- Buzzebees API ---------------------------------------------------------

# The only variable operator login needs.
BUZZEBEES_APP_ID=

# Optional — the endpoint that authenticates operators. Buzzebees exposes
# several login endpoints; set this if operators are not authenticated by
# /merchant/login.
# BUZZEBEES_LOGIN_PATH=/merchant/login

# --- Buzzebees service account ---------------------------------------------
# Used for the app's own API calls, not for signing anyone in. The till values
# here belong to the service account and are separate from what an operator
# types at the login screen.

BUZZEBEES_USERNAME=
BUZZEBEES_PASSWORD=
BUZZEBEES_TERMINAL_ID=
BUZZEBEES_BRANCH_ID=
BUZZEBEES_BRAND_ID=

# Optional — override to point at a non-production environment.
# BUZZEBEES_MERCHANT_BASE_URL=https://api1servicewallet.buzzebees.com
# BUZZEBEES_STAMP_WALLET_BASE_URL=https://stampwalletmodule.buzzebees.com
