# Copy to .env.local and fill in. Never commit .env.local.

# --- App login -------------------------------------------------------------

# Signs the session cookie. Use a random string of at least 32 characters:
#   openssl rand -base64 48
SESSION_SECRET=

# Operators sign in with their own Buzzebees credentials — there is no local
# user list to configure. The Buzzebees variables below are what make login
# work; without them nobody can sign in.

# --- Buzzebees API ---------------------------------------------------------

BUZZEBEES_APP_ID=
BUZZEBEES_TERMINAL_ID=
BUZZEBEES_BRANCH_ID=
BUZZEBEES_BRAND_ID=

# Service account used for the app's own API calls (member lookup, level
# changes). Separate from the operator credentials typed at the login screen.
BUZZEBEES_USERNAME=
BUZZEBEES_PASSWORD=

# Optional — the endpoint that authenticates operators. Buzzebees exposes
# several login endpoints; set this if operators are not authenticated by
# /merchant/login.
# BUZZEBEES_LOGIN_PATH=/merchant/login

# Optional — override to point at a non-production environment.
# BUZZEBEES_MERCHANT_BASE_URL=https://api1servicewallet.buzzebees.com
# BUZZEBEES_STAMP_WALLET_BASE_URL=https://stampwalletmodule.buzzebees.com
